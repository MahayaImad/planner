# Copier ce fichier en .env et adapter les valeurs.

DATABASE_URL=postgresql://planner:planner@db:5432/planner

# OBLIGATOIRE en production : l'API refuse de démarrer sans clé propre.
# Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origines autorisées à appeler l'API, séparées par des virgules.
# Le joker « * » est refusé en production : l'API traite des requêtes
# authentifiées et ne doit pas répondre à n'importe quel site.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Générations d'emplois du temps menées en parallèle, et threads
# accordés à chacune. Chaque résolution mobilise déjà plusieurs cœurs :
# augmenter GENERATIONS_SIMULTANEES au-delà du nombre de cœurs disponibles
# ralentit tout le monde.
GENERATIONS_SIMULTANEES=2
SOLVEUR_THREADS=8
# Plafond du temps de calcul demandable par un client, en secondes.
LIMITE_SECONDES_MAX=900

# En développement, une SECRET_KEY éphémère est générée si elle est vide
# et le joker CORS est toléré.
DEBUG=false
